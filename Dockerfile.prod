# Docker production configuration for Telecom Outage Intelligence System
# Build: docker build -f Dockerfile.prod -t telecom-noc:latest .
# Run: docker run -p 8000:8000 -p 3000:3000 telecom-noc:latest

# Stage 1: Backend builder
FROM python:3.13-slim as backend-builder

WORKDIR /app/backend

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .


# Stage 3: Production runtime
FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend from builder
COPY --from=backend-builder /app/backend /app/backend



# Set environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV VITE_API_URL=http://localhost:8000

# Install production WSGI server
RUN pip install gunicorn uvicorn

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start service
CMD ["sh", "-c", "cd backend && gunicorn main:app -w 4 -b 0.0.0.0:8000 --timeout 60"]
