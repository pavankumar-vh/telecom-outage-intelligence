# Docker production configuration for Telecom Outage Intelligence System
# Build: docker build -f Dockerfile.prod -t telecom-noc:latest .
# Run: docker run -p 8000:8000 -p 3000:3000 telecom-noc:latest

# Stage 1: Backend builder
FROM python:3.13-slim as backend-builder

WORKDIR /app/backend

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .

# Stage 2: Frontend builder
FROM node:18-alpine as frontend-builder

WORKDIR /app/frontend

# Copy and install npm dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source
COPY frontend/ .

# Build frontend
RUN npm run build

# Stage 3: Production runtime
FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend from builder
COPY --from=backend-builder /app/backend /app/backend

# Copy frontend build from builder
COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

# Set environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV VITE_API_URL=http://localhost:8000

# Install production WSGI server
RUN pip install gunicorn uvicorn

# Expose ports
EXPOSE 8000 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start services
CMD ["sh", "-c", "cd backend && gunicorn main:app -w 4 -b 0.0.0.0:8000 --timeout 60 & cd frontend && python -m http.server 3000"]
